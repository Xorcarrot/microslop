{
  "manifest_version": 3,
  "name": "Microslop",
  "version": "1.0.0",
  "description": "A parody extension that replaces \"Microsoft\" with \"Microslop\" on every page.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
